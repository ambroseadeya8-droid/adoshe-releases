{
  "name": "adoshe-enterprises-desktop",
  "version": "3.1.0",
  "description": "ADOSHE Enterprises Accounting & Management System",
  "main": "main.js",
  "author": "ADOSHE Enterprises",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.adoshe.enterprises.accounting",
    "productName": "ADOSHE Accounting System",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "adoshe.html", "update-config.json", "package.json"],
    "publish": [{ "provider": "github", "owner": "ambroseadeya8-droid", "repo": "adoshe-releases", "releaseType": "release" }],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ADOSHE Accounting System"
    }
  }
}
